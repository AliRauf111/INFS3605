# Copy this file to .env.local and fill in real values. Never commit .env.local.
# These are only read by server code. Do not rename them with a NEXT_PUBLIC_ prefix,
# because that would copy them into browser code.

# Supabase project settings (Project Settings > API Keys in the Supabase dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Optional: turns on live AI extraction and drafting. Leave blank to use the clearly
# labelled simulated mode instead.
ANTHROPIC_API_KEY=
# Optional: override the model used for AI features
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional: demo mode puts the fictional demo data back to its original state on every
# full page load (refresh, typed address or sign-in). It is on unless this says off.
# Only rows labelled fictional_demo are ever reset.
# DEMO_MODE=off

# Optional: Payments module live connections. Without all of these, Payments runs in a
# clearly labelled demo mode on fictional records and never sends anything.
# PAYMENTS_MODE=live                 # must say live, and Xero and Gmail must both be set
# XERO_CLIENT_ID=                    # Xero custom connection (read-only accounting scopes)
# XERO_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=                  # Gmail API (gmail.readonly and gmail.send)
# GOOGLE_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# GMAIL_SENDER=accounts@your-business.com.au
# TWILIO_ACCOUNT_SID=                # SMS (optional)
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=                       # your registered sender number or sender ID

# Optional: an email address shown on the Support page. Leave blank to point people to the owner.
SUPPORT_EMAIL=

# Only used by `npm run seed:users` to create the two fictional demo accounts.
DEMO_ADMIN_EMAIL=sarah@tutorcompass.example
DEMO_ADMIN_PASSWORD=choose-a-long-password
DEMO_OWNER_EMAIL=owner@tutorcompass.example
DEMO_OWNER_PASSWORD=choose-a-different-long-password

# Weekly Owner Briefing. Demo by default: emails are simulated and nothing is sent.
# BRIEFING_MODE=live                 # real sends through the Gmail variables above
# CRON_SECRET=                       # long random value; Vercel sends it to /api/briefing/cron
# APP_URL=https://tutorcompass.app   # the link inside the briefing email
