{
  "name": "Tutor Compass",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [3000, 54321, 54323],
  "portsAttributes": {
    "3000": { "label": "Tutor Compass", "onAutoForward": "openPreview" },
    "54321": { "label": "Local Supabase API" },
    "54323": { "label": "Local Supabase Studio" }
  },
  "postCreateCommand": "npm ci",
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    }
  }
}
